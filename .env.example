APP_NAME="Trimas Visitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack

MAIL_MAILER=log
MAIL_FROM_ADDRESS=resepsionis@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Integrasi Google Sheets (OAuth). Kosongkan jika belum dipakai.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"

# Notifikasi WhatsApp ke penerima. log = hanya tulis ke log; fonnte = kirim lewat fonnte.com
WHATSAPP_DRIVER=log
FONNTE_TOKEN=
